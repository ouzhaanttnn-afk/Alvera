# Local development only. Never use real personal data locally.
APP_MODE=local
APP_URL=http://127.0.0.1:3000
DATA_DIR=.local
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
TOKEN_SECRET=
CRON_SECRET=
# Local login: enter this password and then LOCAL_ADMIN_TOTP_CODE. Not production MFA.
LOCAL_ADMIN_PASSWORD=
LOCAL_ADMIN_TOTP_CODE=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=
SEND_APPLICANT_RECEIPT=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Leave false until legal review and approved privacy text have been completed.
LEGAL_REVIEW_APPROVED=false
PRIVACY_NOTICE_PATH=
PRIVACY_NOTICE_VERSION=
DATA_CONTROLLER_NAME=
DOCUMENTS_ENABLED=false
SIGNATURE_ENABLED=false
RESIDENCE_DOCUMENT_ENABLED=false
RESIDENCE_DOCUMENT_REQUIRED=false
# JSON array of field names, server and client share this policy.
REQUIRED_FIELDS=["identityNumber","identityType","name","province","district","neighborhood","phone","address","nationality","occupation","amount"]
RETENTION_DAYS=365
MAX_UPLOAD_MB=5
# HTTPS antivirus gateway, POST raw bytes; must return {"clean":true}.
FILE_SCAN_URL=
FILE_SCAN_TOKEN=
# trusted proxy must overwrite this header; leave empty to rate limit globally.
TRUSTED_IP_HEADER=

# Remote intake stays closed until all deployment gates pass.
MASAK_INTAKE_ENABLED=false
